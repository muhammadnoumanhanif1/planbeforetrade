# Trading mode: 'test' (recommended - no real trades) or 'live' (executes real trades)
# IMPORTANT: Always start with 'test' mode to verify configuration!
TRADING_MODE=test

# Risk management - what % of balance to risk per trade (0.01 = 1%)
RISK_PER_TRADE_PERCENT=0.01

# Maximum number of concurrent trades allowed (default 2)
MAX_ACTIVE_TRADES=2

# Maximum daily losses allowed in Risk units (1R = 1 risk per trade)
DAILY_LOSS_LIMIT_R=3

