# TEMPORARY: set to true to disable login redirects on protected pages during AdSense crawl/indexing
# Default is disabled when unset.
TEMPORARY_PUBLIC_ACCESS=true
# TEMPORARY: set to true to bypass premium/SaaS subscription boundaries in client + server checks
# Default is disabled when unset.
TEMPORARY_SAAS_BYPASS=true
NEXT_PUBLIC_TEMPORARY_SAAS_BYPASS=true
# Required for `/ads.txt` generation and server-side AdSense verification script output
# Optional: custom domain used for metadata/sitemap/robots
